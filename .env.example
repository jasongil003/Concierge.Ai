APP_NAME=Concierge.Ai
APP_HOST=0.0.0.0
APP_PORT=8080
PROPERTY_ID=demo-hotel
HOTEL_CONFIG_PATH=data/hotel.json
DB_PATH=state/concierge.db
SESSION_TTL_MINUTES=30

# Local model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_THINK=false
MAX_OUTPUT_TOKENS=160

# ANTlabs prototype integration.
# Start with mock. Change to browser_handoff only after the exact SG5 fields are validated.
ANTLABS_MODE=mock
ANTLABS_AUTH_URL=
ANTLABS_AUTH_METHOD=POST
ANTLABS_ROOM_FIELD=room
ANTLABS_LAST_NAME_FIELD=last_name
ANTLABS_SESSION_FIELD=session
ANTLABS_PASSTHROUGH_FIELDS=
