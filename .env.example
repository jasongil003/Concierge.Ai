APP_NAME=Concierge.Ai
APP_HOST=127.0.0.1
APP_PORT=8080
# Optional default property ID for a single-property deployment. Leave blank
# for a clean installation and create the first property in Admin onboarding.
PROPERTY_ID=
DB_PATH=state/concierge.db
UPLOAD_ROOT=state/uploads

# The on-prem MVP stores data in SQLite at DB_PATH. Docker Compose mounts /state.
DATABASE_URL=
REDIS_URL=
ADMIN_BOOTSTRAP_USERNAME=root
# Local development bootstrap only. Set a unique password (12+ characters)
# before using the production Compose profile.
ADMIN_BOOTSTRAP_PASSWORD=admin
# Set a random token of at least 32 characters before production startup.
METRICS_TOKEN=
# Exact public DNS names served by this instance, comma-separated.
CANONICAL_HOSTS=concierge.example.com
# Canonical HTTPS origin used for administrator recovery links.
PUBLIC_BASE_URL=https://concierge.example.com
# Source CIDRs allowed to open the Admin UI and Admin API. The local installer
# binds the app to loopback; add only trusted management networks if needed.
ADMIN_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# Initial trusted management proxies. Configure the saved Management Access
# proxy ranges in the Admin UI as well; Guest proxy ranges are separate.
FORWARDED_ALLOW_IPS=172.29.0.2

# Bounded provider bulkheads, retries, and circuit breaker.
AI_PROVIDER_CONCURRENCY_LIMIT=8
AI_PROVIDER_CONCURRENCY_LIMITS={"gemini":8,"openai":8,"claude":8,"local":4}
AI_PROVIDER_QUEUE_CAPACITY=32
AI_PROVIDER_QUEUE_WAIT_SECONDS=1.5
AI_PROVIDER_RETRY_ATTEMPTS=1
AI_PROVIDER_RETRY_BASE_SECONDS=0.25
AI_PROVIDER_CIRCUIT_FAILURES=4
AI_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=20
# Hotel knowledge ingestion limits (bytes/counts)
KNOWLEDGE_MAX_FILE_BYTES=26214400
KNOWLEDGE_MAX_FILES_PER_UPLOAD=5
KNOWLEDGE_MAX_FILES_PER_PROPERTY=500
KNOWLEDGE_STORAGE_QUOTA_BYTES=2147483648
KNOWLEDGE_MAX_EXTRACTED_CHARS=500000
KNOWLEDGE_PDF_MEMORY_LIMIT_BYTES=805306368
SESSION_TTL_MINUTES=30

# AI routing
# local | gemini | openai | compatible | hybrid | auto
AI_PROVIDER_MODE=auto
AI_GUEST_MODE_SWITCH=true
AI_DEFAULT_MODE=auto
MAX_OUTPUT_TOKENS=160
# install.sh generates this securely on first installation and preserves it on reruns.
CREDENTIAL_ENCRYPTION_SECRET=

# Local AI
# For Docker on a laptop, host.docker.internal usually reaches Ollama/LM Studio on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional local inference. Appliance installers set false until it is enabled.
LOCAL_AI_ENABLED=true
# Comma-separated local AI endpoints approved by the deployment operator.
# Include OLLAMA_BASE_URL above when setting alternate local model servers.
LOCAL_AI_ALLOWED_ENDPOINTS=
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_THINK=false

# Google Gemini
# Admin UI supports Gemini API keys now. Google OAuth requires configured OAuth client
# credentials and consent-screen approval before production use.
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_ADVANCED_MODEL=gemini-3.8-flash
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# OpenAI
# OpenAI API usage is separate from consumer ChatGPT plans.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_ADVANCED_MODEL=gpt-5.6-terra

# Generic OpenAI-compatible endpoint (OpenRouter, vLLM, LM Studio, private gateway, etc.)
COMPATIBLE_API_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_FAST_MODEL=
COMPATIBLE_ADVANCED_MODEL=

# Groq / Anthropic / GitHub Copilot provider management is configured through
# Settings > AI Models. GitHub Copilot requires an eligible official SDK/API integration.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Live nearby recommendations
GOOGLE_PLACES_API_KEY=
PLACES_RADIUS_METERS=5000
PLACES_MAX_RESULTS=6

# ANTlabs integration. Mock mode does not contact gateway hardware.
# Live handoff targets the SG5 built-in processor URL documented in ANTlabs Custom Portal Developer Guide r1.01.
ANTLABS_MODE=mock
ANTLABS_AUTH_URL=https://<sg5-host>/login/main.ant?c=proc
ANTLABS_AUTH_METHOD=POST
ANTLABS_ROOM_FIELD=uid
ANTLABS_LAST_NAME_FIELD=pwd
ANTLABS_SESSION_FIELD=
ANTLABS_SESSION_CONTEXT_KEY=
ANTLABS_PASSTHROUGH_FIELDS=
