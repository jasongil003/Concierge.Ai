+    'AI_PROVIDER_CONCURRENCY_LIMITS',
+    'AI_PROVIDER_MODE',
+    'AI_PROVIDER_QUEUE_CAPACITY',
+    'AI_PROVIDER_QUEUE_WAIT_SECONDS',
+    'AI_PROVIDER_RETRY_ATTEMPTS',
+    'AI_PROVIDER_RETRY_BASE_SECONDS',
+    'ALLOW_BODY_PROPERTY_SELECTION',
+    'ALLOW_DEMO_SETTINGS',
+    'ANTLABS_AUTH_METHOD',
+    'ANTLABS_AUTH_URL',
+    'ANTLABS_LAST_NAME_FIELD',
+    'ANTLABS_MODE',
+    'ANTLABS_PASSTHROUGH_FIELDS',
+    'ANTLABS_ROOM_FIELD',
+    'ANTLABS_SESSION_CONTEXT_KEY',
+    'ANTLABS_SESSION_FIELD',
+    'APP_DEBUG',
+    'APP_ENVIRONMENT',
+    'APP_NAME',
+    'CANONICAL_HOSTS',
+    'COMPATIBLE_ADVANCED_MODEL',
+    'COMPATIBLE_API_BASE_URL',
+    'COMPATIBLE_API_KEY',
+    'COMPATIBLE_FAST_MODEL',
+    'CONCIERGE_BACKUP_ENCRYPTION_KEY',
+    'CONCIERGE_BUILD_DATE',
+    'CONCIERGE_COMMIT',
+    'CONCIERGE_DEPLOYMENT_MODE',
+    'CONCIERGE_TESTING',
+    'CONCIERGE_VERSION',
+    'CREDENTIAL_ENCRYPTION_SECRET',
+    'DATABASE_URL',
+    'DB_CONNECT_TIMEOUT_SECONDS',
+    'DB_MAX_OVERFLOW',
+    'DB_PATH',
+    'DB_POOL_RECYCLE_SECONDS',
+    'DB_POOL_SIZE',
+    'DB_POOL_TIMEOUT_SECONDS',
+    'DB_STATEMENT_TIMEOUT_MS',
+    'ENABLE_BACKGROUND_WORKERS',
+    'FORWARDED_ALLOW_IPS',
+    'GEMINI_ADVANCED_MODEL',
+    'GEMINI_API_KEY',
+    'GEMINI_FAST_MODEL',
+    'GOOGLE_PLACES_API_KEY',
+    'GUEST_DATA_RETENTION_DAYS',
+    'GUEST_NOTIFICATION_RETENTION_DAYS',
+    'INTELLIGENT_GUEST_UI_GLOBAL_ENABLED',
+    'KNOWLEDGE_MAX_EXTRACTED_CHARS',
+    'KNOWLEDGE_MAX_FILES_PER_PROPERTY',
+    'KNOWLEDGE_MAX_FILES_PER_UPLOAD',
+    'KNOWLEDGE_MAX_FILE_BYTES',
+    'KNOWLEDGE_PDF_MEMORY_LIMIT_BYTES',
+    'KNOWLEDGE_STORAGE_QUOTA_BYTES',
+    'LOCAL_AI_ALLOWED_ENDPOINTS',
+    'LOCAL_AI_ENABLED',
+    'MAX_OUTPUT_TOKENS',
+    'METRICS_TOKEN',
+    'OLLAMA_BASE_URL',
+    'OLLAMA_MODEL',
+    'OLLAMA_THINK',
+    'OLLAMA_TIMEOUT_SECONDS',
+    'OPENAI_ADVANCED_MODEL',
+    'OPENAI_API_KEY',
+    'OPENAI_FAST_MODEL',
+    'PLACES_MAX_RESULTS',
+    'PLACES_RADIUS_METERS',
+    'PROPERTY_ID',
+    'PUBLIC_BASE_URL',
+    'PYTHON_DOTENV_DISABLED',
+    'REDIS_URL',
+    'RETENTION_MAINTENANCE_INTERVAL_SECONDS',
+    'SESSION_TTL_MINUTES',
+    'STATE_DIRECTORY',
+    'UPLOAD_ROOT',
+})
+RUNTIME_SETTINGS = frozenset({
+    "PATH", "HOME", "TMPDIR", "TMP", "TEMP", "LANG", "LC_ALL", "LC_CTYPE",
+    "SYSTEMROOT", "WINDIR", "SSL_CERT_FILE", "SSL_CERT_DIR",
+    "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "http_proxy", "https_proxy", "no_proxy",
+    "PGPASSFILE", "PGSERVICEFILE", "PGSSLMODE", "PGSSLROOTCERT", "PGSSLCERT",
+    "PGSSLKEY", "KRB5CCNAME", "KRB5_CONFIG",
+})
+
+
+def application_environment(values=None):
+    environment = {
+        name: os.environ[name]
+        for name in APPLICATION_SETTINGS | RUNTIME_SETTINGS
+        if name in os.environ
+    }
+    environment.setdefault("PATH", os.defpath)
+    environment.update({
+        name: value for name, value in (values or {}).items()
+        if name in APPLICATION_SETTINGS | RUNTIME_SETTINGS
+    })
+    return environment
