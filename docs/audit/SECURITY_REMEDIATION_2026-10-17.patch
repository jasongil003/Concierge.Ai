+"""Explicit application environment for source install and service children.
+
+Application settings may come from the operator's environment or the selected
+.env file. Unrelated host credentials and Python injection settings are excluded.
+"""
+
+import os
+
+
+APPLICATION_SETTINGS = frozenset({
+    'ADMIN_ALLOWED_CIDRS',
+    'ADMIN_BOOTSTRAP_PASSWORD',
+    'ADMIN_BOOTSTRAP_USERNAME',
+    'ADMIN_COOKIE_SECURE',
+    'ADMIN_LOCKOUT_ATTEMPTS',
+    'ADMIN_LOCKOUT_MINUTES',
