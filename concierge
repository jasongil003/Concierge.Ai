#!/usr/bin/env bash
set -Eeuo pipefail

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
case "$(uname -s)" in
    Linux) PLATFORM=linux ;;
    Darwin) PLATFORM=macos ;;
    *) printf 'Unsupported operating system.\n' >&2; exit 1 ;;
esac
command_name=${1:-}
if [[ -z "$command_name" ]]; then
    printf 'Usage: ./concierge {serve|start|stop|restart|status|doctor|health|logs}\n' >&2
    exit 2
fi
shift
case "$command_name" in
    status|doctor)
        exec python3 "$ROOT_DIR/deploy/common/diagnostics.py" "$command_name" \
            --mode auto --root "$ROOT_DIR" --config "$ROOT_DIR/.env"
        ;;
esac
[[ -x "$ROOT_DIR/.venv/bin/python" ]] || { printf 'Run ./install.sh first.\n' >&2; exit 1; }
if [[ "$command_name" == serve ]]; then
    exec "$ROOT_DIR/.venv/bin/python" "$ROOT_DIR/deploy/source_service.py" \
        --root "$ROOT_DIR" --platform "$PLATFORM" serve
fi
case "$command_name" in
    start|restart)
        "$ROOT_DIR/.venv/bin/python" "$ROOT_DIR/deploy/source_install.py" \
            validate --root "$ROOT_DIR" --python "$ROOT_DIR/.venv/bin/python" >/dev/null
        "$ROOT_DIR/.venv/bin/python" "$ROOT_DIR/deploy/source_service.py" \
            --root "$ROOT_DIR" --platform "$PLATFORM" "$command_name" "$@"
        exec "$ROOT_DIR/.venv/bin/python" "$ROOT_DIR/deploy/source_service.py" \
            --root "$ROOT_DIR" --platform "$PLATFORM" wait-health --timeout 120
        ;;
esac
exec "$ROOT_DIR/.venv/bin/python" "$ROOT_DIR/deploy/source_service.py" \
    --root "$ROOT_DIR" --platform "$PLATFORM" "$command_name" "$@"
