<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.conciergeai.backup</string>
  <key>ProgramArguments</key><array><string>/usr/local/bin/concierge</string><string>internal-backup</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Library/Logs/Concierge.AI/backup.out.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/Concierge.AI/backup.err.log</string>
</dict>
</plist>
